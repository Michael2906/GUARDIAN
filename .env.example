# GUARDIAN — copy to .env and fill in real values
PORT=3000
NODE_ENV=development

# Azure SQL Database
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=guardian_db
AZURE_SQL_USER=guardianadmin
AZURE_SQL_PASSWORD=your-password
AZURE_SQL_PORT=1433
SQL_SYNC_ALTER=false
SQL_LOGGING=false

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
TOTP_ISSUER=GUARDIAN
TOTP_WINDOW=1
